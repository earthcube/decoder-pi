# Binned DepBelowSurf maxValue counts (meters).
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?bin (COUNT(DISTINCT ?subj) AS ?n)
WHERE {
  GRAPH ?g {
    ?subj schema:variableMeasured ?vm .
    ?vm a schema:PropertyValue ;
        schema:name "DepBelowSurf" ;
        schema:maxValue ?maxValue .
  }
  BIND(xsd:decimal(?maxValue) AS ?mx)
  BIND(
    IF(?mx < 50, "<50",
    IF(?mx < 200, "50-200",
    IF(?mx < 1000, "200-1000",
    IF(?mx < 4000, "1000-4000", ">=4000"))))
    AS ?bin
  )
}
GROUP BY ?bin
